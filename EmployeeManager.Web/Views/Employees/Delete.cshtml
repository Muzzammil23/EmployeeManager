@model EmployeeManager.Models.Data.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h1>Delete Employee</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this employee?
</div>

<table class="table">
    <tbody>
        <tr>
            <th>Employee Number</th>
            <td>@Model.EmployeeNumber</td>
        </tr>

        <tr>
            <th>Name</th>
            <td>
                @Model.FirstName
                @Model.LastName
            </td>
        </tr>

        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>

        <tr>
            <th>Department</th>
            <td>@Model.Department</td>
        </tr>

        <tr>
            <th>Job Title</th>
            <td>@Model.JobTitle</td>
        </tr>
    </tbody>
</table>

<form asp-controller="Employees"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Delete Employee
    </button>

    <a asp-controller="Employees"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>